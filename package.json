        "@dhis2/cli-app-scripts": "12.11.5",
        "@dhis2/config-eslint": "^0.2.2",
        "@dhis2/config-prettier": "^0.2.2",
        "@dhis2/rule-engine": "^3.8.3",
        "@eslint/compat": "^2.1.1",
        "@types/jest": "^30.0.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "prettier": "^3.7.4",
        "typescript": "^5.9.3",
