{
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "esnext",
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@dhis2/rule-engine": [
                "node_modules/@dhis2/rule-engine/rule-engine.d.mts"
            ]
        }
    },
    "include": ["src", "types", "tests"]
}
